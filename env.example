# ---- Server-side only. Never commit real values. ----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=               # public "anon" key: used with each signed-in user's own login token (RLS applies)
SUPABASE_SERVICE_ROLE_KEY=       # SECRET: scans, imports, account deletion only. Bypasses RLS.
ADMIN_USER_IDS=                  # comma-separated Supabase user ids allowed to press "Scan now" and receive source-failure alerts
CRON_SECRET=                     # 16+ random characters; protects /api/scan
SITE_URL=https://YOUR-APP.vercel.app   # used in password-reset emails
ALLOW_SIGNUP=false               # true = anyone can create an account; false = invite-only
SITECHECK_CONTACT=you@example.com      # put in the User-Agent when scanning other people's sites
# INSECURE_COOKIES=1             # local http testing only
